diff --git a/drivers/regulator/twl6030-regulator.c b/drivers/regulator/twl6030-regulator.c
--- a/drivers/regulator/twl6030-regulator.c
+++ b/drivers/regulator/twl6030-regulator.c
@@ -81,6 +81,7 @@
 #define TWL6030_SMPS_MULT		0xB3
 #define SMPS_MULTOFFSET_SMPS4	BIT(0)
 #define SMPS_MULTOFFSET_VIO	BIT(1)
+#define SMPS_MULTOFFSET_SMPS1	BIT(3)
 #define SMPS_MULTOFFSET_SMPS3	BIT(6)
 
 static inline int
@@ -500,6 +501,42 @@
 	.get_status		= twl6030reg_get_status,
 };
 
+/*
+ * SMPS1 is controlled by the OMAP voltage controller.  The ordinary TWL6032
+ * SMPS3/SMPS4/VIO selector table does not describe this rail.  Report its
+ * programmed voltage without offering a second writer for the MPU supply.
+ * The offset bit and conversion match the older OMAP TWL6030 VC callbacks.
+ */
+static int twl6032smps1_get_voltage(struct regulator_dev *rdev)
+{
+	struct twlreg_info *info = rdev_get_drvdata(rdev);
+	u8 offset;
+	int selector, ret;
+
+	selector = twlreg_read(info, TWL_MODULE_PM_RECEIVER,
+			       VREG_VOLTAGE_SMPS);
+	if (selector < 0)
+		return selector;
+	if (!selector)
+		return 0;
+	if (selector == 58)
+		return 1350000;
+	if (selector > 57)
+		return -EINVAL;
+
+	ret = twl_i2c_read_u8(TWL_MODULE_PM_RECEIVER, &offset,
+			      TWL6030_SMPS_OFFSET);
+	if (ret < 0)
+		return ret;
+
+	return (offset & SMPS_MULTOFFSET_SMPS1 ? 709000 : 607700) +
+		12660 * (selector - 1);
+}
+
+static const struct regulator_ops twl6032smps1_readonly_ops = {
+	.get_voltage = twl6032smps1_get_voltage,
+};
+
