+		.name = "SMPS1",
+		.id = TWL6032_REG_SMPS1,
+		.ops = &twl6032smps1_readonly_ops,
+		.type = REGULATOR_VOLTAGE,
+		.owner = THIS_MODULE,
+	},
+};
 
