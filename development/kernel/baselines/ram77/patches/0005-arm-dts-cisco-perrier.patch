+};
+&{/ocp/interconnect@48000000/segment@0/target-module@5b000} {
+	ti,no-reset-on-init;
+};
+&{/ocp/interconnect@48000000/segment@0/target-module@5d000} {
+	ti,no-reset-on-init;
+};
+&{/ocp/interconnect@4a300000/segment@10000/target-module@c000} {
+	ti,no-reset-on-init;
+};
+&{/ocp/interconnect@48000000/segment@0/target-module@86000} {
+	ti,no-reset-on-init;
+};
+&{/ocp/interconnect@4a300000/segment@10000/target-module@4000} {
+	ti,no-reset-on-init;
+	ti,no-idle-on-init;
+};
+&{/ocp/interconnect@4a300000/segment@0/target-module@4000} {
+	ti,no-reset-on-init;
+	ti,no-idle-on-init;
+};
+&{/ocp/interconnect@4a300000/segment@10000/target-module@8000} {
+	ti,no-reset-on-init;
+	ti,no-idle-on-init;
+};
+&{/ocp/interconnect@4a000000/segment@100000/target-module@0} {
+	ti,no-reset-on-init;
+	ti,no-idle-on-init;
+};
+&{/ocp/interconnect@4a000000/segment@0/target-module@2000} {
+	ti,no-reset-on-init;
