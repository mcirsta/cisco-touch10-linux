diff --git a/arch/arm/mach-omap2/io.c b/arch/arm/mach-omap2/io.c
--- a/arch/arm/mach-omap2/io.c
+++ b/arch/arm/mach-omap2/io.c
@@ -609,6 +609,9 @@
 
 void __init omap4430_init_late(void)
 {
+	/* No PMIC, voltage or low-power policy changes in the RAM trial. */
+	if (of_machine_is_compatible("cisco,perrier-ram"))
+		return;
 	omap_pm_soc_init = omap4_pm_init;
 }
 #endif
diff --git a/drivers/clk/ti/clk-44xx.c b/drivers/clk/ti/clk-44xx.c
--- a/drivers/clk/ti/clk-44xx.c
+++ b/drivers/clk/ti/clk-44xx.c
@@ -802,6 +802,10 @@
 
 	ti_clk_add_aliases();
 
+	/* Perrier RAM trial: retain stock USB/audio PLL configuration. */
+	if (of_machine_is_compatible("cisco,perrier-ram"))
+		return 0;
+
 	/*
 	 * Lock USB DPLL on OMAP4 devices so that the L3INIT power
 	 * domain can transition to retention state when not in use.
diff --git a/drivers/mmc/core/block.c b/drivers/mmc/core/block.c
--- a/drivers/mmc/core/block.c
+++ b/drivers/mmc/core/block.c
@@ -42,6 +42,7 @@
 #include <linux/idr.h>
 #include <linux/debugfs.h>
 #include <linux/rpmb.h>
+#include <linux/of.h>
 
 #include <linux/mmc/ioctl.h>
 #include <linux/mmc/card.h>
@@ -2586,6 +2587,9 @@
 	 * and the write protect switch.
 	 */
 	md->read_only = mmc_blk_readonly(card);
+	/* Perrier RAM trial: all eMMC areas reject write opens. */
+	if (of_machine_is_compatible("cisco,perrier-ram"))
+		md->read_only = 1;
 
 	if (mmc_host_can_cmd23(card->host) && mmc_card_can_cmd23(card))
 		md->flags |= MMC_BLK_CMD23;
