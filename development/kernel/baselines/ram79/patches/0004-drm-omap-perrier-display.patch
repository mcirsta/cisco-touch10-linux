+static bool dsi_vm_calc_line_totals(unsigned int pck_div,
+		unsigned long byteclk, unsigned long pck_min,
+		unsigned long pck_nom, unsigned long pck_max,
+		int panel_htot, int *dsi_htot, int *dispc_htot)
+{
+	u64 numerator, denominator, total, pixels;
+	unsigned int step;
+
+	if (!pck_div || !byteclk || !pck_nom || panel_htot <= 0 ||
+	    pck_min > pck_nom || pck_nom > pck_max)
+		return false;
+
+	/* Both clocks originate at the same DCO. TXBYTECLKHS divides it by
+	 * 16, while DISPC uses HSDIV, LCK and PCK. Select an integral line
+	 * in both domains without comparing their rounded integer Hz rates.
+	 */
+	step = pck_div / gcd(pck_div, 16);
+	numerator = (u64)panel_htot * byteclk;
+	denominator = (u64)pck_nom * step;
+	total = div64_u64(numerator + denominator / 2, denominator) * step;
+	if (!total || total > INT_MAX)
+		return false;
+
+	pixels = div64_u64(total * 16, pck_div);
+	if (!pixels || pixels > INT_MAX)
+		return false;
+
+	/* Keep the panel's line rate within its requested clock interval. */
+	if (numerator < total * pck_min || numerator > total * pck_max)
+		return false;
+
+	*dsi_htot = total;
+	*dispc_htot = pixels;
+	return true;
+}
