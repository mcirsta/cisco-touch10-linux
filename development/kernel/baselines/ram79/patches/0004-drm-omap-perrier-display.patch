+static void dsi_bridge_pre_enable(struct drm_bridge *bridge)
+{
+	struct dsi_data *dsi = drm_bridge_to_dsi(bridge);
+	int r;
+
+	if (!of_machine_is_compatible("cisco,perrier-ram"))
+		return;
+
+	cancel_delayed_work_sync(&dsi->dsi_disable_work);
+	dsi_bus_lock(dsi);
+	if (!dsi->iface_enabled)
+		dsi_enable(dsi);
+	if (!dsi->iface_enabled) {
+		r = -EIO;
+		goto err;
+	}
+
+	/* OMAP4460 i422: continuous clock starts with the first HS packet.
+	 * Use the existing L4 command channel, leaving the video channel's
+	 * ordinary VP source untouched. Later transfers set their own speed.
+	 */
+	dsi_vc_enable_hs(&dsi->output, VC_CMD, true);
+	r = dsi_vc_send_null(dsi, VC_CMD, dsi->dsidev->channel);
+	if (!r)
+		r = dsi_sync_vc(dsi, VC_CMD);
+	if (r)
+		goto err;
+
+	dev_info(dsi->dev, "Perrier HS clock primed on command channel, vc=%08x\n",
+		 dsi_read_reg(dsi, DSI_VC_CTRL(VC_CMD)));
+	goto out;
+err:
+	dev_err(dsi->dev, "Perrier DSI clock pre-enable failed: %d\n", r);
+out:
+	dsi_bus_unlock(dsi);
+}
