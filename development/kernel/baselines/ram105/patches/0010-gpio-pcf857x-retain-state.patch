diff --git a/drivers/gpio/gpio-pcf857x.c b/drivers/gpio/gpio-pcf857x.c
--- a/drivers/gpio/gpio-pcf857x.c
+++ b/drivers/gpio/gpio-pcf857x.c
@@ -73,6 +73,7 @@
 	struct mutex		lock;		/* protect 'out' */
 	unsigned int		out;		/* software latch */
 	unsigned int		status;		/* current status */
+	bool			retain_state_shutdown;
 	unsigned int		irq_enabled;	/* enabled irqs */
 
 	int (*write)(struct i2c_client *client, unsigned int data);
@@ -376,6 +377,8 @@
 	gpio->chip.label = client->name;
 
 	gpio->client = client;
+	gpio->retain_state_shutdown =
+		device_property_read_bool(&client->dev, "retain-state-shutdown");
 	i2c_set_clientdata(client, gpio);
 
 	/* NOTE:  these chips have strange "quasi-bidirectional" I/O pins.
@@ -437,6 +440,9 @@
 {
 	struct pcf857x *gpio = i2c_get_clientdata(client);
 
+	if (gpio->retain_state_shutdown)
+		return;
+
 	/* Drive all the I/O lines high */
 	gpio->write(gpio->client, BIT(gpio->chip.ngpio) - 1);
 }
