diff --git a/arch/arm/mach-omap2/io.c b/arch/arm/mach-omap2/io.c
--- a/arch/arm/mach-omap2/io.c
+++ b/arch/arm/mach-omap2/io.c
@@ -21,6 +21,7 @@
 
 #include <asm/tlb.h>
 #include <asm/mach/map.h>
+#include <asm/traps.h>
 
 #include <linux/omap-dma.h>
 
@@ -49,6 +50,119 @@
 #include "prm44xx.h"
 #include "opp2xxx.h"
 #include "omap-secure.h"
+#include "perrier-pmu-probe.h"
+
+/* Temporary, read-only RAM probe; remove after identifying the PMU gate. */
+static bool perrier_sder_fault __initdata;
+static bool perrier_auth_fault __initdata;
+
+static int __init perrier_pmu_undef(struct pt_regs *regs, unsigned int instr)
+{
+	if (regs->ARM_pc == (unsigned long)perrier_sder_read_insn)
+		perrier_sder_fault = true;
+	else if (regs->ARM_pc == (unsigned long)perrier_auth_read_insn)
+		perrier_auth_fault = true;
+	else
+		return 1;
+	regs->ARM_pc += 4;
+	return 0;
+}
+
+static struct undef_hook perrier_sder_hook __initdata = {
+	.instr_mask = 0x0fff0fff,
+	.instr_val = 0x0e110f31,
+	.cpsr_mask = MODE_MASK,
+	.cpsr_val = SVC_MODE,
+	.fn = perrier_pmu_undef,
+};
+
+static struct undef_hook perrier_auth_hook __initdata = {
+	.instr_mask = 0x0fff0fff,
+	.instr_val = 0x0e170ede,
+	.cpsr_mask = MODE_MASK,
+	.cpsr_val = SVC_MODE,
+	.fn = perrier_pmu_undef,
+};
+
+static int __init perrier_pmu_read_security(void)
+{
+	unsigned long flags;
+	u32 sder = 0, auth = 0, pmcr;
+
+	if (!of_machine_is_compatible("cisco,perrier-ram"))
+		return 0;
+	register_undef_hook(&perrier_sder_hook);
+	register_undef_hook(&perrier_auth_hook);
+	local_irq_save(flags);
+	asm volatile(".global perrier_sder_read_insn\n"
+		     "perrier_sder_read_insn: mrc p15, 0, %0, c1, c1, 1\n"
+		     : "+r" (sder));
+	asm volatile(".global perrier_auth_read_insn\n"
+		     "perrier_auth_read_insn: mrc p14, 0, %0, c7, c14, 6\n"
+		     : "+r" (auth));
+	asm volatile("mrc p15, 0, %0, c9, c12, 0" : "=r" (pmcr));
+	local_irq_restore(flags);
+	unregister_undef_hook(&perrier_auth_hook);
+	unregister_undef_hook(&perrier_sder_hook);
+	pr_info("PERRIER_PMU_SECURITY sder=%08x sder_fault=%d auth=%08x auth_fault=%d pmcr=%08x\n",
+		sder, perrier_sder_fault, auth, perrier_auth_fault, pmcr);
+	return 0;
+}
+late_initcall(perrier_pmu_read_security);
+
+/* Temporary RAM-only test: exercise one idle event counter and restore it. */
+static int __init perrier_pmu_counter_selftest(void)
+{
+	unsigned long flags;
+	u32 pmcr, enabled, irqs, selector, old_event, old_count;
+	u32 event_readback, hardware_count, software_count, loops = 100000;
+	u32 event = 0x68, zero = 0, one = 1;
+	int i;
+
+	if (!of_machine_is_compatible("cisco,perrier-ram"))
+		return 0;
+	local_irq_save(flags);
+	asm volatile("mrc p15, 0, %0, c9, c12, 0" : "=r" (pmcr));
+	asm volatile("mrc p15, 0, %0, c9, c12, 1" : "=r" (enabled));
+	asm volatile("mrc p15, 0, %0, c9, c14, 1" : "=r" (irqs));
+	if ((pmcr & 1) || enabled || irqs) {
+		local_irq_restore(flags);
+		pr_info("PERRIER_PMU_SELFTEST skipped pmcr=%08x enabled=%08x irqs=%08x\n",
+			pmcr, enabled, irqs);
+		return 0;
+	}
+	asm volatile("mrc p15, 0, %0, c9, c12, 5" : "=r" (selector));
+	asm volatile("mcr p15, 0, %0, c9, c12, 5" : : "r" (zero) : "memory");
+	isb();
+	asm volatile("mrc p15, 0, %0, c9, c13, 1" : "=r" (old_event));
+	asm volatile("mrc p15, 0, %0, c9, c13, 2" : "=r" (old_count));
+	asm volatile("mcr p15, 0, %0, c9, c13, 1" : : "r" (event) : "memory");
+	asm volatile("mcr p15, 0, %0, c9, c13, 2" : : "r" (zero) : "memory");
+	asm volatile("mrc p15, 0, %0, c9, c13, 1" : "=r" (event_readback));
+	asm volatile("mcr p15, 0, %0, c9, c12, 0" : : "r" (pmcr | 1) : "memory");
+	asm volatile("mcr p15, 0, %0, c9, c12, 1" : : "r" (one) : "memory");
+	isb();
+	asm volatile("1: subs %0, %0, #1\n\tbne 1b"
+		     : "+r" (loops) : : "cc", "memory");
+	asm volatile("mrc p15, 0, %0, c9, c13, 2" : "=r" (hardware_count));
+	asm volatile("mcr p15, 0, %0, c9, c13, 1" : : "r" (zero) : "memory");
+	isb();
+	for (i = 0; i < 100; i++)
+		asm volatile("mcr p15, 0, %0, c9, c12, 4" : : "r" (one) : "memory");
+	asm volatile("mrc p15, 0, %0, c9, c13, 2" : "=r" (software_count));
+	asm volatile("mcr p15, 0, %0, c9, c12, 2" : : "r" (one) : "memory");
+	asm volatile("mcr p15, 0, %0, c9, c12, 0" : : "r" (pmcr) : "memory");
+	asm volatile("mcr p15, 0, %0, c9, c13, 1" : : "r" (old_event) : "memory");
+	asm volatile("mcr p15, 0, %0, c9, c13, 2" : : "r" (old_count) : "memory");
+	asm volatile("mcr p15, 0, %0, c9, c12, 5" : : "r" (selector) : "memory");
+	isb();
+	local_irq_restore(flags);
+	pr_info("PERRIER_PMU_SELFTEST pmcr=%08x enabled=%08x irqs=%08x event=%08x hardware=%u software=%u old_event=%08x old_count=%u restored=1\n",
+		pmcr, enabled, irqs, event_readback, hardware_count,
+		software_count, old_event, old_count);
+	return 0;
+}
+late_initcall(perrier_pmu_counter_selftest);
 
 /*
  * omap_clk_soc_init: points to a function that does the SoC-specific
@@ -609,6 +723,9 @@
 
