+static void dsi_bridge_pre_enable(struct drm_bridge *bridge)
+{
+	struct dsi_data *dsi = drm_bridge_to_dsi(bridge);
+
+	if (!of_machine_is_compatible("cisco,perrier-ram"))
+		return;
+
+	/* The downstream bridge requests preceding-host pre-enable first.
+	 * Supply its DSI clock here; leave video startup to the ordinary
+	 * enable path after the bridge has been programmed.
+	 */
+	cancel_delayed_work_sync(&dsi->dsi_disable_work);
+	dsi_bus_lock(dsi);
+	if (!dsi->iface_enabled)
+		dsi_enable(dsi);
+	if (!dsi->iface_enabled)
+		dev_err(dsi->dev, "Perrier DSI PHY pre-enable failed\n");
+	dsi_bus_unlock(dsi);
+}
