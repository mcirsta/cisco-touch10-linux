+static int tc358765_start_hs_clock(struct tc_data *tc)
+{
+	const struct mipi_dsi_host_ops *ops = tc->dsi->host->ops;
+	const struct mipi_dsi_msg msg = {
+		.channel = tc->dsi->channel,
+		.type = MIPI_DSI_NULL_PACKET,
+	};
+
+	if (!ops || !ops->transfer)
+		return -EOPNOTSUPP;
+
+	/* The I2C block needs HS clock after reset. Force this packet to HS,
+	 * independent of the normal control messages' low-power preference.
+	 */
+	return ops->transfer(tc->dsi->host, &msg);
 }
 
