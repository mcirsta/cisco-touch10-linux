&timer1_target {
 ti,no-reset-on-init;
 ti,no-idle;
 timer@0 {
  assigned-clocks = <&l4_wkup_clkctrl ((0x40) - 0x20) 24>;
  assigned-clock-parents = <&sys_32k_ck>;
 };
};
/ {
 cpus {
  cpu0: cpu@0 {
   operating-points = <
    350000 1025000
    700000 1200000
    920000 1313000
   >;
   clock-latency = <300000>;
   #cooling-cells = <2>;
  };
 };
 thermal-zones {
cpu_thermal: cpu_thermal {
 polling-delay-passive = <250>;
 polling-delay = <1000>;
 thermal-sensors = <&bandgap 0>;
 cpu_trips: trips {
  cpu_alert0: cpu_alert {
   temperature = <100000>;
   hysteresis = <2000>;
   type = "passive";
  };
  cpu_crit: cpu_crit {
   temperature = <125000>;
   hysteresis = <2000>;
   type = "critical";
  };
 };
 cpu_cooling_maps: cooling-maps {
  map0 {
   trip = <&cpu_alert0>;
   cooling-device =
    <&cpu0 (~0) (~0)>;
  };
 };
};
 };
 ocp {
  bandgap: bandgap@4a002260 {
   reg = <0x4a002260 0x4
          0x4a00232C 0x4
          0x4a002378 0x18>;
   compatible = "ti,omap4460-bandgap";
   interrupts = <0 126 4>;
   gpios = <&gpio3 22 0>;
   #thermal-sensor-cells = <0>;
  };
  abb_mpu: regulator-abb-mpu {
   status = "okay";
   reg = <0x4a307bd0 0x8>, <0x4a306014 0x4>,
         <0x4A002268 0x4>;
   reg-names = "base-address", "int-address",
        "efuse-address";
   ti,abb_info = <
   1025000 0 0 0 0 0
   1200000 0 0 0 0 0
   1313000 0 0 0x100000 0x40000 0
   1375000 1 0 0 0 0
   1389000 1 0 0 0 0
   >;
  };
  abb_iva: regulator-abb-iva {
   status = "okay";
   reg = <0x4a307bd8 0x8>, <0x4a306010 0x4>,
         <0x4A002268 0x4>;
   reg-names = "base-address", "int-address",
        "efuse-address";
   ti,abb_info = <
   950000 0 0 0 0 0
   1140000 0 0 0 0 0
   1291000 0 0 0x200000 0 0
   1375000 1 0 0 0 0
   1376000 1 0 0 0 0
   >;
  };
 };
};
&cpu_thermal {
 thermal-sensors = <&bandgap>;
 coefficients = <348 (-9301)>;
};
&l4_cfg_segment_300000 {
 ranges = <0x00000000 0x00300000 0x020000>,
   <0x00040000 0x00340000 0x001000>,
   <0x00020000 0x00320000 0x004000>,
   <0x00024000 0x00324000 0x002000>,
   <0x00026000 0x00326000 0x001000>,
   <0x00027000 0x00327000 0x001000>,
   <0x00028000 0x00328000 0x001000>,
   <0x00029000 0x00329000 0x001000>,
   <0x00030000 0x00330000 0x010000>,
   <0x0002a000 0x0032a000 0x002000>,
   <0x0002c000 0x0032c000 0x004000>,
   <0x00010000 0x00310000 0x008000>,
   <0x00018000 0x00318000 0x004000>,
   <0x0001c000 0x0031c000 0x002000>,
   <0x0001e000 0x0031e000 0x002000>;
};
&l4_cfg_target_0 {
 ranges = <0x00000000 0x00000000 0x00010000>,
   <0x00010000 0x00010000 0x00008000>,
   <0x00018000 0x00018000 0x00004000>,
   <0x0001c000 0x0001c000 0x00002000>,
   <0x0001e000 0x0001e000 0x00002000>,
   <0x00020000 0x00020000 0x00004000>,
   <0x00024000 0x00024000 0x00002000>,
   <0x00026000 0x00026000 0x00001000>,
   <0x00027000 0x00027000 0x00001000>,
   <0x00028000 0x00028000 0x00001000>,
   <0x00029000 0x00029000 0x00001000>,
   <0x0002a000 0x0002a000 0x00002000>,
   <0x0002c000 0x0002c000 0x00004000>,
   <0x00030000 0x00030000 0x00010000>;
};
&pmu {
 compatible = "arm,cortex-a9-pmu";
 interrupts = <0 54 4>,
       <0 55 4>;
};
/include/ "omap446x-clocks.dtsi"
&cpu0 { /delete-property/ operating-points; };
&cpu_alert0 { temperature = <85000>; };
&cpu_crit { temperature = <95000>; };
/ {
 aliases {
  serial0 = &uart3;
  mmc0 = &mmc2;
  i2c0 = &i2c1;
  i2c1 = &i2c2;
  i2c2 = &i2c3;
  i2c3 = &i2c4;
  /delete-property/ serial1;
  /delete-property/ serial2;
  /delete-property/ serial3;
  /delete-property/ mmc1;
  /delete-property/ mmc2;
  /delete-property/ mmc3;
  /delete-property/ mmc4;
 };
 perrier_emmc_vcc: regulator-emmc-vcc {
  compatible = "regulator-fixed";
  regulator-name = "perrier-emmc-vcc";
  regulator-min-microvolt = <2950000>;
  regulator-max-microvolt = <2950000>;
  regulator-always-on;
 };
 perrier_bridge_vddio: regulator-bridge-vddio {
  compatible = "regulator-fixed";
  regulator-name = "perrier-bridge-vddio-logic-only";
  regulator-min-microvolt = <1800000>;
  regulator-max-microvolt = <1800000>;
  regulator-always-on;
 };
 perrier_bridge_vdd: regulator-bridge-vdd {
  compatible = "regulator-fixed";
  regulator-name = "perrier-bridge-vdd-logic-only";
  regulator-min-microvolt = <1200000>;
  regulator-max-microvolt = <1200000>;
  regulator-always-on;
 };
 perrier_panel_3v3: regulator-panel-3v3 {
  compatible = "regulator-fixed";
  regulator-name = "perrier-panel-3v3";
  regulator-min-microvolt = <3300000>;
  regulator-max-microvolt = <3300000>;
  gpio = <&gpio6 3 0>;
  enable-active-high;
 };
 perrier_panel: panel {
  backlight = <&perrier_backlight>;
  compatible = "panel-lvds";
  data-mapping = "vesa-24";
  power-supply = <&perrier_panel_3v3>;
  width-mm = <217>;
  height-mm = <136>;
  panel-timing {
   clock-frequency = <71074000>;
   hactive = <1280>;
   hfront-porch = <78>;
   hback-porch = <79>;
   hsync-len = <3>;
   vactive = <800>;
   vfront-porch = <12>;
   vback-porch = <10>;
   vsync-len = <1>;
  };
  port {
   perrier_panel_in: endpoint {
    remote-endpoint = <&perrier_bridge_out>;
   };
  };
 };
 perrier_pwm10: pwm-backlight-timer {
  compatible = "ti,omap-dmtimer-pwm";
  ti,timers = <&timer10>;
  #pwm-cells = <3>;
 };
 perrier_backlight: backlight {
  compatible = "pwm-backlight";
  pinctrl-names = "default";
  pinctrl-0 = <&perrier_backlight_pwm_pin &perrier_backlight_enable_pin>;
  power-supply = <&perrier_backlight_5v>;
  enable-gpios = <&gpio5 23 0>;
  pwms = <&perrier_pwm10 0 50000 0>;
  brightness-levels = <0 64 128 192 255>;
  default-brightness-level = <4>;
 };
 perrier_usb_phy: usb-phy {
  compatible = "usb-nop-xceiv";
  #phy-cells = <0>;
  pinctrl-names = "default";
  pinctrl-0 = <&perrier_ethernet_phy_pins>;
  reset-gpios = <&gpio4 14 1>;
  clocks = <&auxclk1_ck>;
  clock-names = "main_clk";
  clock-frequency = <19200000>;
  assigned-clocks = <&auxclk1_src_ck>;
  assigned-clock-parents = <&sys_clkin_ck>;
 };
 perrier_backlight_5v: regulator-backlight-5v {
  compatible = "regulator-fixed";
  regulator-name = "perrier-backlight-5v";
  regulator-min-microvolt = <5000000>;
  regulator-max-microvolt = <5000000>;
  pinctrl-names = "default";
  pinctrl-0 = <&perrier_backlight_5v_pin>;
  gpio = <&gpio5 29 0>;
  enable-active-high;
  startup-delay-us = <11000>;
 };
 perrier_touch_5v: regulator-touch-5v {
  compatible = "regulator-fixed";
  regulator-name = "perrier-touch-5v";
  regulator-min-microvolt = <5000000>;
  regulator-max-microvolt = <5000000>;
  pinctrl-names = "default";
  pinctrl-0 = <&perrier_touch_5v_pin>;
  gpio = <&gpio4 24 0>;
  enable-active-high;
 };
 perrier_touch_3v3: regulator-touch-3v3 {
  compatible = "regulator-fixed";
  regulator-name = "perrier-touch-3v3";
  regulator-min-microvolt = <3300000>;
  regulator-max-microvolt = <3300000>;
  pinctrl-names = "default";
  pinctrl-0 = <&perrier_touch_3v3_pin>;
  gpio = <&gpio4 25 0>;
  enable-active-high;
 };
 leds {
  compatible = "gpio-leds";
  pinctrl-names = "default";
  pinctrl-0 = <&perrier_mute_led_pins>;
  led-0 {
   color = <1>;
   function = "micmute";
   gpios = <&gpio4 26 0>;
   default-state = "off";
  };
  led-1 {
   color = <2>;
   function = "micmute";
   gpios = <&gpio4 23 0>;
   default-state = "off";
  };
 };
 led-controller {
  compatible = "pwm-leds";
  led-0 {
   color = <0>;
   function = "status";
