 bridge@f {
  compatible = "toshiba,tc358765";
  reg = <0x0f>;
  vddio-supply = <&perrier_bridge_vddio>;
  vdd-supply = <&perrier_bridge_vdd>;
  reset-gpios = <&gpio4 6 1>;
  ports {
   #address-cells = <1>;
   #size-cells = <0>;
   port@0 {
    reg = <0>;
    perrier_bridge_in: endpoint {
     remote-endpoint = <&perrier_dsi_out>;
     data-lanes = <1 2 3 4>;
    };
   };
   port@1 {
    reg = <1>;
    perrier_bridge_out: endpoint {
     remote-endpoint = <&perrier_panel_in>;
    };
   };
  };
 };
};
