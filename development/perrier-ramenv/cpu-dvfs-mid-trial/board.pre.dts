  opp-shared;
  opp-350000000 {
   opp-hz = /bits/ 64 <350000000>;
  };
  opp-700000000 {
   opp-hz = /bits/ 64 <700000000>;
  };
 };
};
&cpu0 {
 clocks = <&dpll_mpu_m2_ck>;
 operating-points-v2 = <&perrier_cpu_opp>;
};
&{/cpus/cpu@1} {
 operating-points-v2 = <&perrier_cpu_opp>;
};
/ {
 perrier_vdd_mpu: regulator@4a306000 {
  compatible = "cisco,perrier-omap4-mpu-vc";
  reg = <0x4a306000 0x2000>;
  regulator-name = "perrier-vdd-mpu";
  regulator-min-microvolt = <1152100>;
  regulator-max-microvolt = <1215400>;
  regulator-always-on;
 };
};
&cpu0 {
 cpu-supply = <&perrier_vdd_mpu>;
};
&{/cpus/cpu@1} {
 cpu-supply = <&perrier_vdd_mpu>;
};
&{/opp-table-cpu/opp-350000000} {
 opp-microvolt = <1152100>;
};
&{/opp-table-cpu/opp-700000000} {
 opp-microvolt = <1215400>;
};
