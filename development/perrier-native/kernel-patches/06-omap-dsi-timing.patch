+static void dsi_bridge_pre_enable(struct drm_bridge *bridge)
+{
+	struct dsi_data *dsi = drm_bridge_to_dsi(bridge);
+	int r;
+
+	if (!of_machine_is_compatible("cisco,perrier-ram"))
+		return;
+
+	dev_info(dsi->dev, "Perrier DSI pre-enter iface=%d\n", dsi->iface_enabled);
+	/* The TC358765 must be configured after the DSI PHY is running but
+	 * before video starts. Its bridge requests upstream pre-enable first.
+	 */
+	cancel_delayed_work_sync(&dsi->dsi_disable_work);
+	dsi_bus_lock(dsi);
+	if (!dsi->iface_enabled)
+		dsi_enable(dsi);
+	if (!dsi->iface_enabled)
+		goto err_host;
+
+	/* Initialize the DISPC clock and DSI video channel, but leave the
+	 * manager stopped until the downstream TC358765 has been programmed.
+	 */
+	r = dsi_init_dispc(dsi);
+	if (r)
+		goto err_dispc;
+	if (dsi->mode != OMAP_DSS_DSI_VIDEO_MODE) {
+		r = -EINVAL;
+		goto err_mode;
+	}
+	r = dsi_enable_video_mode(dsi, VC_VIDEO);
+	if (r)
+		goto err_mode;
+	dsi->perrier_video_prepared = true;
+	dev_info(dsi->dev, "Perrier DSI video prepared ctrl=%08x\n",
+		 dsi_read_reg(dsi, DSI_CTRL));
+	goto out;
+
+err_mode:
+	dsi_uninit_dispc(dsi);
+err_dispc:
+	dev_err(dsi->dev, "Perrier video pre-enable failed: %d\n", r);
+	goto out;
+err_host:
+	dev_err(dsi->dev, "Perrier DSI host pre-enable failed\n");
+out:
+	dsi_bus_unlock(dsi);
+}
+
 static void dsi_bridge_enable(struct drm_bridge *bridge)
 {
 	struct dsi_data *dsi = drm_bridge_to_dsi(bridge);
 	struct omap_dss_device *dssdev = &dsi->output;
+	int r;
 
 	cancel_delayed_work_sync(&dsi->dsi_disable_work);
 
 	dsi_bus_lock(dsi);
+
+	if (of_machine_is_compatible("cisco,perrier-ram")) {
+		if (!dsi->perrier_video_prepared) {
+			dev_err(dsi->dev, "Perrier video was not prepared\n");
+			goto out;
+		}
+		r = dss_mgr_enable(dssdev);
+		if (r) {
+			dev_err(dsi->dev, "Perrier scanout start failed: %d\n", r);
+			goto out;
+		}
+		dsi->video_enabled = true;
+		goto out;
+	}
 
 	if (!dsi->iface_enabled)
 		dsi_enable(dsi);
@@ -4670,6 +4765,7 @@
 
 	dsi->video_enabled = true;
 
+out:
 	dsi_bus_unlock(dsi);
 }
 
